{
  "name": "aeroplan-android",
  "version": "1.5.4",
  "private": true,
  "description": "氢计划（AeroPlan）PWA 的 Android 打包工程（Capacitor + GitHub Actions）",
  "scripts": {
    "web:copy": "node scripts/copy-web.mjs",
    "android:add": "cap add android",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:sync": "cap sync android",
    "android:build": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "sharp": "^0.33.0",
    "terser": "^5.31.0"
  }
}
