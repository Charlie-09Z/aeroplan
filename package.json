{
  "name": "qingjihua-android",
  "version": "0.5.2",
  "private": true,
  "description": "氢计划（AeroPlan）PWA 的 Android 打包工程（Capacitor + GitHub Actions）",
  "scripts": {
    "web:copy": "node scripts/copy-web.mjs",
    "android:add": "cap add android",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:sync": "cap sync android",
    "android:build": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "sharp": "^0.33.0"
  }
}
